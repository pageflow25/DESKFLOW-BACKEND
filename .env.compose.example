# Variaveis lidas pelo Docker Compose para configurar host/porta/volumes.
# Elas podem ficar no mesmo .env usado pela aplicacao ou em um arquivo separado
# passado com: docker compose --env-file .env.compose up -d

# Porta publicada no host Windows.
APP_PORT=8000

# Caminhos no host Windows que serao montados dentro do container.
# Use caminhos absolutos em producao para facilitar backup e operacao.
DESKFLOW_LOGS_PATH=C:/deskflow/backend/logs
DESKFLOW_TEMP_PATH=C:/deskflow/backend/temp_orcamentos
DESKFLOW_DOWNLOADS_PATH=C:/Bremen/OPs
