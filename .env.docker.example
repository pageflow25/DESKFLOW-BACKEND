# Banco de dados
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_SSL=true

# JWT
SECRET_KEY=troque-este-valor
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=DESKFLOW PCP
DEBUG=false
NODE_ENV=production

# Credenciais Bremen Auth
DEFAULT_URL=https://exemplo
DEFAULT_IDENTIFIER=identificador
DEFAULT_USER=usuario
DEFAULT_PASSWORD=senha

# API Bremen
BREMEN_API_URL=https://exemplo
BREMEN_API_TOKEN=
API_TIMEOUT=300
BREMEN_503_MAX_WAIT_SECONDS=300
BREMEN_503_RETRY_BASE_SECONDS=5
BREMEN_503_RETRY_MAX_INTERVAL_SECONDS=30

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=token

# Dentro do container. O docker-compose monta ./data/bremen-ops neste caminho.
DOWNLOAD_BASE_PATH=/data/bremen-ops

# Automacao escolas conveniadas
CONVENIADO_AUTOMACAO_ATIVA=false
CONVENIADO_AUTOMACAO_HORARIOS=15:30
CONVENIADO_AUTOMACAO_TIMEZONE=America/Sao_Paulo
CONVENIADO_DATA_ENTREGA_OFFSET_DIAS=7
